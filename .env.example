# OpenAI API Key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Email Verification ---
# Backend origin (API base URL).
# For local dev: http://localhost:8000
# For production: https://docagent-v2-production.up.railway.app
APP_BASE_URL=http://localhost:8000
# Frontend URL prefixed to verification links in emails:
#   <FRONTEND>/api/auth/verify-email?token=...&lang=...
# For production: https://docagent-v2-frontend-production.up.railway.app
# (Defaults to the production frontend when APP_BASE_URL is the production
# backend, else to APP_BASE_URL.)
APP_FRONTEND_URL=

# SendGrid dynamic template (preferred provider — used when both values are set).
SENDGRID_API_KEY=sendgrid_api_key_here
SENDGRID_TEMPLATE_ID=sendgrid_template_id_here
SENDGRID_FROM_EMAIL=noreply@docagent.ai
SENDGRID_FROM_NAME=DocAgent AI
SENDGRID_SUBJECT=Account validation
# Dutch (nl) dynamic template. Leave empty to fall back to the English template above.
SENDGRID_TEMPLATE_ID_NL=
SENDGRID_SUBJECT_NL=Account validering

# SMTP server (e.g. Brevo: smtp-relay.brevo.com:587) — fallback when SendGrid is not configured.
# Leave SMTP_HOST empty to skip sending email and print verification links to the server console (useful for local dev).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=DocAgent AI
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# --- CORS ---
# Comma-separated extra browser origins allowed to call the API.
# Defaults already include the Railway frontend + localhost dev servers.
CORS_ORIGINS=
# Regex of origins allowed on top of the list (default: any *.up.railway.app, since Railway
# regenerates subdomains on redeploy). Set to "off" to restrict to CORS_ORIGINS only.
CORS_ORIGIN_REGEX=
# Set to true to allow ANY origin (disables credentials). Use only for debugging.
CORS_ALLOW_ALL=false
