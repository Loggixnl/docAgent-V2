# OpenAI API Key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Email Verification (SMTP) ---
# Base URL used to build verification links in emails.
# For local dev: http://localhost:8000
# For production: your Railway/public domain, e.g. https://your-app.up.railway.app
APP_BASE_URL=http://localhost:8000

# SMTP server (e.g. Brevo: smtp-relay.brevo.com:587)
# Leave SMTP_HOST empty to skip sending email and print verification links to the server console (useful for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=DocAgent AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
